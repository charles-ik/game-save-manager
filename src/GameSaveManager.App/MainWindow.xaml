<Window x:Class="GameSaveManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Game Save Manager" Width="1220" Height="800" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" FontSize="14" Background="{StaticResource Canvas}" Foreground="{StaticResource Text}">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,8,8"/></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="Margin" Value="0,0,8,8"/></Style>
    <!-- Disabled until a row is selected. Tag = the list. -->
    <Style x:Key="NeedsSelection" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Style.Triggers><DataTrigger Binding="{Binding Tag.SelectedItem, RelativeSource={RelativeSource Self}}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,6,0,0"/></Style>
    <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Margin" Value="4,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Extended"/>
      <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowHeight" Value="40"/>
          </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,8">
      <DockPanel>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Click="CancelOperation_Click" Margin="12,0,0,0" Visibility="Collapsed"/>
        <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True" VerticalAlignment="Center" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,6"/>
      </DockPanel>
    </Border>
    <TabControl x:Name="Tabs">
      <TabItem>
        <TabItem.Header><DockPanel><TextBlock x:Name="GameCount" DockPanel.Dock="Right" Text="0" Style="{StaticResource Badge}"/><TextBlock Text="Games"/></DockPanel></TabItem.Header>
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Scan folders" Click="Scan_Click" Style="{StaticResource Primary}" VerticalAlignment="Top" Margin="16,0,0,0"/>
            <StackPanel><TextBlock Text="Games" Style="{StaticResource PageTitle}"/><TextBlock Text="Installations found in your watched folders. Hold Ctrl or Shift to select several rows. The Playnite column is only about adding a game to your Playnite library: Needs review means its title or launch file is unconfirmed. It does not affect backups, which the Saves column shows." Style="{StaticResource Muted}"/></StackPanel>
          </DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,20,0,4">
            <Button Content="Review game…" Click="ReviewGame_Click" Style="{StaticResource NeedsSelection}" Tag="{Binding ElementName=GamesGrid}"/>
            <Button Content="Retry metadata" Click="RetryMetadata_Click" Style="{StaticResource NeedsSelection}" Tag="{Binding ElementName=GamesGrid}"/>
            <Button Content="Exclude" Click="Exclude_Click" Style="{StaticResource NeedsSelection}" Tag="{Binding ElementName=GamesGrid}" ToolTip="Works on every selected row. Keep the game in this list but never back it up or send it to Playnite."/>
            <Button Content="Remove…" Click="RemoveGame_Click" Style="{StaticResource NeedsSelection}" Tag="{Binding ElementName=GamesGrid}" ToolTip="Works on every selected row. Take the game out of this app completely. It is no longer listed, scanned or backed up."/>
            <Button x:Name="RemoveMissingButton" Content="Remove missing…" Click="RemoveMissing_Click" ToolTip="Remove games whose installation folder no longer exists from this list."/>
            <Button Content="Export coverage…" Click="Export_Click"/>
          </WrapPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,4,0,12">
            <ComboBox x:Name="GamesFilter" DockPanel.Dock="Right" Width="250" Margin="8,0,0,0" SelectionChanged="Filter_Changed" ToolTip="Show only rows with this status"/>
            <TextBlock Text="Search" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="GamesSearch" Margin="0" TextChanged="Filter_Changed"/>
          </DockPanel>
          <Grid>
            <DataGrid x:Name="GamesGrid" MouseDoubleClick="ReviewGame_Click"><DataGrid.Columns>
              <DataGridTextColumn Header="Game" Binding="{Binding Title}" Width="2*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTemplateColumn Header="Playnite" SortMemberPath="Status" CellTemplate="{StaticResource StatusCell}" Width="1.5*"/>
              <DataGridTemplateColumn Header="Saves" SortMemberPath="SaveStatus" CellTemplate="{StaticResource SaveStatusCell}" Width="1.5*"/>
              <DataGridTextColumn Header="Installation folder" Binding="{Binding InstallDirectory}" Width="2.5*" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns></DataGrid>
            <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding ElementName=GamesGrid}" Text="Nothing to show. Clear the search or filter, or add your game folders in Settings and choose Scan folders."/>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem>
        <TabItem.Header><DockPanel><TextBlock x:Name="ProtectedCount" DockPanel.Dock="Right" Text="0" Style="{StaticResource Badge}" ToolTip="Games with a completed local backup"/><TextBlock Text="Backups"/></DockPanel></TabItem.Header>
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Back up now" Click="Backup_Click" Style="{StaticResource Primary}" VerticalAlignment="Top" Margin="16,0,0,0"/>
            <StackPanel><TextBlock Text="Backups" Style="{StaticResource PageTitle}"/><TextBlock Text="Keeps 10 changed versions per game, plus pinned ones. Backups are local; OneDrive uploads them separately, so cloud sync is not verified here." Style="{StaticResource Muted}"/></StackPanel>
          </DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,20,0,4">
            <Button Content="Find saves" Click="FindSaves_Click"/>
            <Button Content="Back up selected" Click="BackupSelected_Click" Style="{StaticResource NeedsSelection}" Tag="{Binding ElementName=SavesGrid}"/>
            <Button Content="Inspect files…" Click="InspectFiles_Click" Style="{StaticResource NeedsSelection}" Tag="{Binding ElementName=SavesGrid}"/>
            <Button Content="Add save location…" Click="AddRule_Click"/>
            <Button Content="Locate unknown saves…" Click="LocateSaves_Click" ToolTip="Search your Documents and AppData folders for save folders of games the save database does not know."/>
            <Button Content="Open backup folder" Click="OpenBackups_Click"/>
          </WrapPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,4,0,12">
            <ComboBox x:Name="SavesFilter" DockPanel.Dock="Right" Width="250" Margin="8,0,0,0" SelectionChanged="Filter_Changed" ToolTip="Show only rows with this status"/>
            <TextBlock Text="Search" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="SavesSearch" Margin="0" TextChanged="Filter_Changed"/>
          </DockPanel>
          <Grid>
            <DataGrid x:Name="SavesGrid" MouseDoubleClick="InspectFiles_Click"><DataGrid.Columns>
              <DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTemplateColumn Header="Protection" SortMemberPath="Status" CellTemplate="{StaticResource StatusCell}" Width="2*"/>
              <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="3*" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns></DataGrid>
            <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding ElementName=SavesGrid}" Text="Nothing to show. Clear the search or filter, or choose Find saves to see what can be backed up."/>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem>
        <TabItem.Header><DockPanel><TextBlock x:Name="AttentionCount" DockPanel.Dock="Right" Text="0" Style="{StaticResource Badge}" Foreground="{StaticResource Warn}"/><TextBlock Text="Needs attention"/></DockPanel></TabItem.Header>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.ColumnSpan="2"><TextBlock Text="Needs attention" Style="{StaticResource PageTitle}"/><TextBlock Text="Games that could not be identified, or whose progress saves have not been located." Style="{StaticResource Muted}"/></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,20,0,12"><TextBlock Text="Search" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="AttentionSearch" Width="260" Margin="0" TextChanged="Filter_Changed"/></StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,20,0,4">
            <Button Content="Review game…" Click="ReviewAttention_Click" Style="{StaticResource NeedsSelection}" Tag="{Binding ElementName=AttentionGrid}"/>
            <Button Content="Add save location…" Click="AddRule_Click" Style="{StaticResource NeedsSelection}" Tag="{Binding ElementName=AttentionGrid}"/>
          </WrapPanel>
          <DataGrid Grid.ColumnSpan="2" Grid.Row="2" x:Name="AttentionGrid" MouseDoubleClick="ReviewAttention_Click"><DataGrid.Columns>
            <DataGridTextColumn Header="Game" Binding="{Binding Title}" Width="2*" ElementStyle="{StaticResource CellText}"/>
            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="4*" ElementStyle="{StaticResource CellText}"/>
          </DataGrid.Columns></DataGrid>
          <TextBlock Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource EmptyHint}" Tag="{Binding ElementName=AttentionGrid}" Text="Nothing needs your attention."/>
          <TextBlock Grid.ColumnSpan="2" Grid.Row="3" Text="Recent activity" Style="{StaticResource SectionTitle}" Margin="0,20,0,8"/>
          <ListBox Grid.ColumnSpan="2" Grid.Row="4" x:Name="ActivityList" Background="{StaticResource Card}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Width="110" Text="{Binding Time, StringFormat={}{0:dd MMM HH:mm}}" Style="{StaticResource Badge}" VerticalAlignment="Top" Margin="0,2,0,0"/><TextBlock Text="{Binding Message}"/></DockPanel>
          </DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock Grid.ColumnSpan="2" Grid.Row="4" Style="{StaticResource EmptyHint}" Tag="{Binding ElementName=ActivityList}" Text="No activity yet."/>
        </Grid>
      </TabItem>
      <TabItem Header="Restore / Move PC">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
          <TextBlock Text="Restore / Move PC" Style="{StaticResource PageTitle}"/><TextBlock Text="Bring saves back from a backup, or prepare everything for a new PC." Style="{StaticResource Muted}" Margin="0,0,0,20"/>
          <Border Style="{StaticResource CardBox}"><StackPanel>
            <TextBlock Text="Restore saves" Style="{StaticResource SectionTitle}"/><TextBlock Text="Pick a version, preview where it will be written, then restore. A safety copy of existing saves is made first." Style="{StaticResource Muted}"/>
            <TextBlock Text="1. Backup to restore from" Style="{StaticResource Label}"/><TextBlock Text="The Saves folder of this PC or the source PC." Style="{StaticResource Muted}"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="Load versions" Click="LoadVersions_Click" Margin="8,6,0,0"/><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseRepository_Click" Margin="8,6,0,0"/><TextBox x:Name="RepositoryPath"/></DockPanel>
            <TextBlock Text="2. Version" Style="{StaticResource Label}"/>
            <Grid Margin="0,6,0,0">
              <ListBox x:Name="VersionsList" Height="150" Background="{StaticResource Canvas}"><ListBox.ItemTemplate><DataTemplate>
                <DockPanel><TextBlock DockPanel.Dock="Right" Text="Pinned" Style="{StaticResource Badge}" Foreground="{StaticResource Warn}" Margin="16,0,0,0" Visibility="{Binding Locked, Converter={StaticResource Visible}}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Timestamp}" Style="{StaticResource Badge}" Margin="16,0,0,0"/><TextBlock Text="{Binding Game}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DockPanel>
              </DataTemplate></ListBox.ItemTemplate><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle></ListBox>
              <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding ElementName=VersionsList}" Text="Choose Load versions to list the backups in this folder."/>
            </Grid>
            <TextBlock Text="3. Path mappings (only when moving PCs)" Style="{StaticResource Label}"/><TextBlock Text="One per line: original folder | new folder" Style="{StaticResource Muted}"/>
            <TextBox x:Name="MappingsText" AcceptsReturn="True" MinHeight="62" VerticalScrollBarVisibility="Auto"/>
            <WrapPanel Margin="0,16,0,0">
              <Button Content="Preview restore" Click="PreviewRestore_Click" Style="{StaticResource NeedsSelection}" Tag="{Binding ElementName=VersionsList}"/>
              <Button Content="Pin / unpin" Click="Pin_Click" Style="{StaticResource NeedsSelection}" Tag="{Binding ElementName=VersionsList}" ToolTip="Pinned versions are never removed by the 10-version limit."/>
            </WrapPanel>
            <TextBox x:Name="RestorePreview" IsReadOnly="True" AcceptsReturn="True" Height="130" VerticalScrollBarVisibility="Auto" Text="The preview lists every file and registry key that will be written."/>
            <Button x:Name="RestoreButton" Content="Restore this version…" Click="Restore_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" IsEnabled="False"/>
          </StackPanel></Border>
          <Border Style="{StaticResource CardBox}"><StackPanel>
            <TextBlock Text="Move to another PC" Style="{StaticResource SectionTitle}"/><TextBlock Text="On the old PC, prepare a migration: pinned save backups, a Playnite package and your custom save rules. Check OneDrive has finished uploading before you switch. On the new PC, restore in the order below." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
            <WrapPanel><Button Content="Prepare migration…" Click="PrepareMigration_Click"/><Button Content="Restore Playnite package…" Click="RestorePlaynite_Click"/><Button Content="Import custom rules…" Click="ImportRules_Click"/><Button Content="Reconnect Playnite folders…" Click="Reconnect_Click"/></WrapPanel>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Settings">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,12,20">
            <Button DockPanel.Dock="Right" Content="Save settings" Click="SaveSettings_Click" Style="{StaticResource Primary}" VerticalAlignment="Top" Margin="16,0,0,0"/>
            <StackPanel><TextBlock Text="Settings" Style="{StaticResource PageTitle}"/><TextBlock Text="Changes apply when you choose Save settings." Style="{StaticResource Muted}"/></StackPanel>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
            <Border Style="{StaticResource CardBox}"><StackPanel>
              <TextBlock Text="Folders" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Watched game folders" Style="{StaticResource Label}" Margin="0,8,0,0"/><TextBlock Text="Where your games are installed, one folder per line. Game installations themselves are never backed up." Style="{StaticResource Muted}"/>
              <DockPanel><Button DockPanel.Dock="Right" Content="Add folder…" Click="AddRoot_Click" Margin="8,6,0,0" VerticalAlignment="Top"/><TextBox x:Name="RootsText" AcceptsReturn="True" MinHeight="70" VerticalScrollBarVisibility="Auto"/></DockPanel>
              <TextBlock Text="Backup destination" Style="{StaticResource Label}"/><TextBlock Text="Must be separate from the game folders. A OneDrive folder gives you an off-PC copy." Style="{StaticResource Muted}"/>
              <DockPanel><Button DockPanel.Dock="Right" Content="Choose…" Click="ChooseDestination_Click" Margin="8,6,0,0"/><TextBox x:Name="DestinationText"/></DockPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource CardBox}"><StackPanel>
              <TextBlock Text="Automation" Style="{StaticResource SectionTitle}"/>
              <CheckBox x:Name="AutomationCheck" Margin="0,8,0,0"><StackPanel><TextBlock Text="Run automatically"/><TextBlock Text="Discover new games, import confirmed ones into Playnite, and back up daily and after you stop playing." Style="{StaticResource Muted}"/></StackPanel></CheckBox>
              <CheckBox x:Name="StartupCheck" Margin="0,12,0,0"><StackPanel><TextBlock Text="Start in the Windows tray when I sign in"/><TextBlock Text="Closing the window keeps the app running in the tray. Use Exit in the tray menu to stop it." Style="{StaticResource Muted}"/></StackPanel></CheckBox>
            </StackPanel></Border>
            <Border Style="{StaticResource CardBox}"><StackPanel>
              <TextBlock Text="Programs" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Ludusavi executable" Style="{StaticResource Label}" Margin="0,8,0,0"/><TextBlock Text="The engine that locates and copies save files." Style="{StaticResource Muted}"/>
              <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="ChooseEngine_Click" Margin="8,6,0,0"/><TextBox x:Name="EngineText"/></DockPanel>
              <TextBlock Text="Playnite executable" Style="{StaticResource Label}"/><TextBlock Text="Filled in automatically once the Playnite companion connects." Style="{StaticResource Muted}"/>
              <TextBox x:Name="PlayniteText"/>
              <TextBlock x:Name="CompanionNotice" Visibility="Collapsed" Foreground="{StaticResource Warn}" Margin="0,16,0,0" Text="The Playnite companion is out of date, so metadata downloads fail. Choose Install Playnite companion, then restart Playnite."/>
              <WrapPanel Margin="0,16,0,-8"><Button Content="Install Playnite companion…" Click="InstallCompanion_Click"/><Button Content="Set up Playnite daily backups" Click="ConfigurePlayniteBackups_Click"/></WrapPanel>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
