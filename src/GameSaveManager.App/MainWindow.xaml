<Window x:Class="GameSaveManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Game Save Manager" Width="1220" Height="800" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22">
      <Border DockPanel.Dock="Right" Background="#243F39" CornerRadius="14" Padding="14,8" VerticalAlignment="Top"><TextBlock Text="LOCAL FIRST · WINDOWS" Foreground="#A6D6BD" FontSize="11" FontWeight="SemiBold"/></Border>
      <StackPanel><TextBlock Text="Keep your progress." FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Your games, saves, and next PC — in one place." Foreground="#9FB4BD" Margin="0,6,0,0"/></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#17242C" CornerRadius="8" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="GAME INSTALLATIONS" FontSize="11" Foreground="#9FB4BD"/><TextBlock x:Name="GameCount" Text="0" FontSize="28" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Grid.Column="1" Background="#17242C" CornerRadius="8" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="NEEDS ATTENTION" FontSize="11" Foreground="#9FB4BD"/><TextBlock x:Name="AttentionCount" Text="0" FontSize="28" Foreground="#E3BC7A" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Background="#17242C" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="CLOUD STATUS" FontSize="11" Foreground="#9FB4BD"/><TextBlock Text="Sync unverified" FontSize="21" Margin="0,8,0,0" ToolTip="Completed local backups are uploaded by the OneDrive desktop app. Check OneDrive before moving PCs."/></StackPanel></Border>
    </Grid>
    <TabControl Grid.Row="2" x:Name="Tabs">
      <TabItem Header="Games"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel><Button Content="Scan folders" Click="Scan_Click" Background="#38765F"/><Button Content="Review selected game" Click="ReviewGame_Click"/><Button Content="Retry metadata" Click="RetryMetadata_Click"/><Button Content="Exclude selected" Click="Exclude_Click"/><Button Content="Export coverage" Click="Export_Click"/></WrapPanel>
        <DataGrid Grid.Row="1" x:Name="GamesGrid"><DataGrid.Columns><DataGridTextColumn Header="Game" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.3*"/><DataGridTextColumn Header="Installation folder" Binding="{Binding InstallDirectory}" Width="3*"/></DataGrid.Columns></DataGrid>
        <TextBlock Grid.Row="2" Foreground="#9FB4BD" Margin="0,12,0,0" Text="Confirmed imports are queued until Playnite is open. Existing library edits are preserved."/>
      </Grid></TabItem>
      <TabItem Header="Backups"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel><Button Content="Find saves" Click="FindSaves_Click"/><Button Content="Back up now" Click="Backup_Click" Background="#38765F"/><Button Content="Back up selected" Click="BackupSelected_Click"/><Button Content="Inspect files" Click="InspectFiles_Click"/><Button Content="Add save location" Click="AddRule_Click"/><Button Content="Open backup folder" Click="OpenBackups_Click"/></WrapPanel>
        <DataGrid Grid.Row="1" x:Name="SavesGrid"><DataGrid.Columns><DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Protection status" Binding="{Binding Status}" Width="1.5*"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="3*"/></DataGrid.Columns></DataGrid>
        <TextBlock Grid.Row="2" Foreground="#9FB4BD" Margin="0,12,0,0" Text="10 changed versions per game, plus pinned backups. A game with no located saves is never marked backed up."/>
      </Grid></TabItem>
      <TabItem Header="Needs attention"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel><Button Content="Review selected game" Click="ReviewAttention_Click"/><Button Content="Add or correct save location" Click="AddRule_Click"/></WrapPanel>
        <DataGrid Grid.Row="1" x:Name="AttentionGrid"><DataGrid.Columns><DataGridTextColumn Header="Game" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="4*"/></DataGrid.Columns></DataGrid>
        <TextBlock Grid.Row="2" Text="Recent activity" Margin="0,14,0,8" Foreground="#9FB4BD"/>
        <ListBox Grid.Row="3" x:Name="ActivityList"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Time, StringFormat={}{0:dd MMM HH:mm}}" Foreground="#9FB4BD" FontSize="11"/><TextBlock Text="{Binding Message}" MaxWidth="1030"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      </Grid></TabItem>
      <TabItem Header="Restore / Move PC"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,8,0">
        <TextBlock Text="Restore saves" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Choose the source PC's Saves folder. Select a version, review its destinations, then restore." Foreground="#9FB4BD" Margin="0,6,0,12"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseRepository_Click"/><Button DockPanel.Dock="Right" Content="Load versions" Click="LoadVersions_Click"/><TextBox x:Name="RepositoryPath"/></DockPanel>
        <ListBox x:Name="VersionsList" Height="140" Margin="0,0,0,12"/>
        <TextBlock Text="Path mappings — one original folder | new folder per line" Foreground="#9FB4BD"/><TextBox x:Name="MappingsText" AcceptsReturn="True" MinHeight="62" VerticalScrollBarVisibility="Auto"/>
        <WrapPanel><Button Content="Preview restore" Click="PreviewRestore_Click"/><Button Content="Restore selected version…" Click="Restore_Click" Background="#38765F"/><Button Content="Pin / unpin version" Click="Pin_Click"/></WrapPanel>
        <TextBox x:Name="RestorePreview" IsReadOnly="True" AcceptsReturn="True" Height="140" VerticalScrollBarVisibility="Auto" Text="A preview will list every destination. A safety copy is created before replacing existing saves."/>
        <Separator Margin="0,8,0,16"/><TextBlock Text="Move to another PC" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Prepare a pinned save backup, Playnite package, and custom rules. Check OneDrive has finished uploading before moving." Foreground="#9FB4BD" Margin="0,6,0,12"/>
        <WrapPanel><Button Content="Prepare migration…" Click="PrepareMigration_Click"/><Button Content="Restore Playnite package…" Click="RestorePlaynite_Click"/><Button Content="Import custom rules…" Click="ImportRules_Click"/><Button Content="Reconnect Playnite folders…" Click="Reconnect_Click"/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Settings"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,8,0">
        <TextBlock Text="Watched game folders — one per line"/><DockPanel><Button DockPanel.Dock="Right" Content="Add folder…" Click="AddRoot_Click"/><TextBox x:Name="RootsText" AcceptsReturn="True" MinHeight="70"/></DockPanel>
        <TextBlock Text="Backup destination"/><DockPanel><Button DockPanel.Dock="Right" Content="Choose…" Click="ChooseDestination_Click"/><TextBox x:Name="DestinationText"/></DockPanel>
        <TextBlock Text="Ludusavi executable"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="ChooseEngine_Click"/><TextBox x:Name="EngineText"/></DockPanel>
        <TextBlock Text="Playnite executable"/><TextBox x:Name="PlayniteText"/>
        <CheckBox x:Name="AutomationCheck" Content="Enable automatic discovery, Playnite imports, and backups"/><CheckBox x:Name="StartupCheck" Content="Start in the Windows tray when I sign in"/>
        <WrapPanel><Button Content="Save settings" Click="SaveSettings_Click" Background="#38765F"/><Button Content="Install Playnite companion…" Click="InstallCompanion_Click"/><Button Content="Configure Playnite routine backups" Click="ConfigurePlayniteBackups_Click"/></WrapPanel>
        <TextBlock Text="Close the window to keep the tray app running. Use Exit in the tray menu to stop it. Games, settings, and registry saves are included where known; game installations are excluded." Foreground="#9FB4BD" Margin="0,8,0,8"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="#17242C" CornerRadius="6" Margin="0,18,0,0" Padding="12"><DockPanel><Button DockPanel.Dock="Right" Content="Cancel operation" Click="CancelOperation_Click" Padding="10,4" Margin="8,0,0,0"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="#B6CAC5" VerticalAlignment="Center"/></DockPanel></Border>
  </Grid>
</Window>
